# Pin the Penpot release for reproducibility — bump intentionally.
# Available tags: https://hub.docker.com/r/penpotapp/frontend/tags
PENPOT_VERSION=2.14.0

# Generated on first install by post-grab.sh — DO NOT commit a real value.
# Regenerate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# Set to true to share anonymous usage stats with the Penpot team.
PENPOT_TELEMETRY_ENABLED=false

# UI:                http://localhost:9001
# Mailcatch inbox:   http://localhost:1080
