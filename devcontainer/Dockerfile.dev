# Use Node.js 22 Alpine as base image
FROM node:22-alpine

# Alpine n'a pas bash par défaut, requis par les devcontainer features et Claude Code
RUN apk add --no-cache bash curl git openssh-client

# Set working directory inside the container
WORKDIR /app

# Copy package files to install dependencies
COPY package*.json ./

# Install dependencies (including dev dependencies for development)
RUN npm ci

# Copy the entire project source code
COPY . .

# Expose the port AdonisJS runs on
EXPOSE 3333

RUN node ace generate:key

# Garde le container en vie pour le devcontainer
CMD ["sleep", "infinity"]


